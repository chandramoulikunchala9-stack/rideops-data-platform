# Copy this file to `.env` and fill in values. `.env` is git-ignored — never commit it.
# Variables are added here as each phase needs them.

# --- General ---
RIDEOPS_ENV=local                 # local | dev | prod
RIDEOPS_LOG_LEVEL=INFO
RIDEOPS_DATA_DIR=./data           # root of landing/bronze/silver/gold when STORAGE_BACKEND=local

# --- Synthetic data (Phase 1) ---
RIDEOPS_SEED=42
RIDEOPS_SCALE=small               # small (fast local) | full (100k+ bookings) | large (Spark testing)
RIDEOPS_DATA_END_DATE=2026-10-31  # last day of generated data; fixed so output is reproducible

# --- PostgreSQL (Phase 2) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rideops
POSTGRES_USER=rideops
POSTGRES_SSLMODE=prefer          # use require for hosted Postgres (Neon)
POSTGRES_PASSWORD=               # required, no default. e.g. python -c "import secrets;print(secrets.token_urlsafe(24))"

# --- Storage (Phase 6) ---
RIDEOPS_STORAGE_BACKEND=local     # local | s3
# S3 bucket names come from Terraform outputs. Do NOT put AWS access keys here:
# use an AWS CLI profile (AWS_PROFILE) or an IAM role.
AWS_PROFILE=
AWS_REGION=ap-south-2
RIDEOPS_S3_RAW_BUCKET=
RIDEOPS_S3_PROCESSED_BUCKET=
RIDEOPS_S3_ANALYTICS_BUCKET=

# --- Databricks (Phase 4, optional) ---
# Prefer `databricks auth login` (OAuth) over personal access tokens.
DATABRICKS_HOST=

# --- Backend (Phase 5) ---
API_CORS_ORIGINS=http://localhost:5173
RETRY_RUNNER_ENABLED=false        # true lets POST /pipelines/{id}/retry start whitelisted local jobs

# --- Costs (Phase 6) ---
MONTHLY_BUDGET_USD=1200           # budget threshold for warnings on SIMULATED cost data

# --- Frontend (Phase 7) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- Lens (Phase 11+, docs/ReContruction/lens-system-design.md §23) ---
LENS_ENABLED=false                # mounts /auth, /workspaces, /healthz, /readyz, /internal/tick
LENS_PROTECT_RIDEOPS=false        # true = existing RideOps routes require sign-in
LENS_ROLE=all                     # all (API + worker + scheduler) | api | worker | scheduler
DATABASE_URL=                     # metadata DB; empty = the POSTGRES_* database (schema `app`)
PUBLIC_APP_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false       # true in production (HTTPS); false only for http://localhost
EMAIL_BACKEND=console             # console logs verification/reset links (development only)
INTERNAL_TOKEN=                   # protects POST /internal/tick; empty disables it
# Connections (Phase 12). Key ring for envelope encryption of connection secrets: versioned base64
# 32-byte keys. Generate one: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
LENS_MASTER_KEYS=                 # e.g. 1:<base64>  (add 2:<base64> to rotate; highest version is active)
ALLOW_PRIVATE_NETWORKS=false      # true only for self-hosted Lens next to private databases
ALLOWED_PORTS=443,1433,1521,3306,5432,6432,27017
EGRESS_IPS=                       # shown in the UI so users can allowlist Lens on their firewalls
HEALTH_TIMEOUT_S=10
RIDEOPS_DEMO_URL=                 # read-only URL to the RideOps DB; seeds the "RideOps demo" connection.
#   Use a dedicated role with SELECT on raw/core/analytics/ops only (never the `app` schema, never
#   a superuser): Lens blocks `app` for the demo anyway, but the role is the first line of defence.
