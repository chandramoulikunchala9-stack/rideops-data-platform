# Store text files with LF line endings in the repository so Linux CI and Docker behave the same as Windows.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.pdf binary
*.parquet binary
